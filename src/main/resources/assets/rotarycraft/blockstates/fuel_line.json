      },
      "apply": {
        "model": "rotarycraft:block/fuel_line_arm",
        "uvlock": false
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "rotarycraft:block/fuel_line_arm",
        "uvlock": false,
        "y": 180
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "rotarycraft:block/fuel_line_arm",
        "uvlock": false,
        "y": 90
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "rotarycraft:block/fuel_line_arm",
        "uvlock": false,
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "rotarycraft:block/fuel_line_arm",
        "uvlock": false,
        "x": 270
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "rotarycraft:block/fuel_line_arm",
        "uvlock": false,
        "x": 90
      }
    }
  ]
}
